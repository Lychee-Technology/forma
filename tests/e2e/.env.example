# ============================================================
# Forma E2E Test Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values

# Forma API
BASE_URL=http://localhost:8080
AUTH_TOKEN=                         # Optional bearer token (leave empty if no auth)

# Postgres (for CDC flush and direct queries)
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DB=forma
PG_SSL_MODE=disable

# Table names (must match server config)
SCHEMA_TABLE=schema_registry_dev
ENTITY_MAIN_TABLE=entity_main_dev
EAV_TABLE=eav_data_dev
CHANGE_LOG_TABLE=change_log_dev

# S3/RustFS — port must match deploy/docker-compose.yml (rustfs publishes 9000)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=forma-cdc
S3_PREFIX=delta
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio_password
S3_USE_SSL=false
S3_USE_PATH=true

# Test parameters
DATASET_SIZE=10000                  # Total entities per schema
BATCH_SIZE=500                      # Entities per batch request
TENANT_ID=test-tenant               # Tenant ID for generated leads

# CDC Flush parameters
CDC_MIN_RECORDS=1000
CDC_MAX_AGE_MS=60000
CDC_BATCH_SIZE=10000
CDC_EST_ROW_BYTES=0
CDC_MAX_BATCH_BYTES=0

# Forma build tools path (relative to project root)
TOOLS_PATH=../../build/tools

# Schema paths (relative to project root)
SCHEMA_DIR=../../cmd/server/schemas
