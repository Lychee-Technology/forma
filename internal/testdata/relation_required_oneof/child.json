{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "parentId"],
  "oneOf": [
    {"required": ["contactSnapshot"]},
    {"required": ["fallback"]}
  ],
  "properties": {
    "id": {"type": "string"},
    "parentId": {"type": "string"},
    "fallback": {"type": "string"},
    "contactSnapshot": {
      "$ref": "parent.json#/properties/contact",
      "x-relation": {"key_property": "parentId"}
    }
  }
}
